<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 is what SPT 4.1 client plugins target (the server side is net10.0). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>3.0.0</Version>
    <Authors>McOnie</Authors>
    <Product>WeaponAttachmentModifier.Client</Product>
    <Description>F12 front end for Weapon Attachment Modifier: live attachment ergonomics, recoil and durability burn tuning.</Description>
    <RootNamespace>WeaponAttachmentModifier.Client</RootNamespace>
    <AssemblyName>WeaponAttachmentModifier.Client</AssemblyName>

    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tuning formula and the category ids are compiled into both halves of the mod so an
         F12 slider and a config.jsonc value with the same number cannot drift apart. -->
    <Compile Include="..\Shared\AttachmentStats.cs" Link="AttachmentStats.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- EFT itself. ItemFactory, ItemTemplates and the ModTemplate family are all public in the
         deobfuscated 4.1 assembly, so no publicised build or spt-reflection is needed. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\ItemComponent.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemTemplate.Types">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\ItemTemplate.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Drop the plugin into BepInEx\plugins.
    Skip with -p:SkipDeploy=true (or SptRoot=CHANGE_ME) when the game is running and holding the
    dll memory-mapped.
    Windows-only for the same reason as the server project; -p:OS=Windows_NT forces it.
  -->
  <Target Name="DeployToSpt" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND '$(SkipDeploy)' != 'true' AND '$(SptPluginsDir)' != '' AND '$(SptRoot)' != 'CHANGE_ME'">
    <PropertyGroup>
      <PluginDeployDir>$(SptPluginsDir)\WeaponAttachmentModifier\</PluginDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)"
          SkipUnchangedFiles="false" ContinueOnError="WarnAndContinue" />
    <Message Text="Deployed $(TargetFileName) to $(PluginDeployDir)" Importance="high" />
  </Target>

</Project>
